# API server port (frontend dev server proxies /api here). Kept distinct from
# PORT so a host-injected PORT can't collide with the Vite dev server.
API_PORT=3000

# Cache TTL for joined client data, in seconds
CACHE_TTL_SECONDS=60

HUBSPOT_PA_KEY=

STRIPE_KEY=

QUICKBOOKS_CLIENT_ID=

QUICKBOOKS_CLIENT_SECRET=