# Copy to .env and fill in. With NO HubSpot/Stripe keys set, the app runs in
# MOCK MODE (realistic fake data) so you can see the dashboard before wiring
# real APIs. Live mode needs HUBSPOT_PA_KEY + STRIPE_KEY.

# HubSpot access token used for CRM reads (companies, deals, tickets).
# Personal-access / private-app token. Scopes: crm.objects.companies.read,
# crm.objects.contacts.read, crm.objects.deals.read, tickets.
HUBSPOT_PA_KEY=

# HubSpot developer key (optional) — attached for developer-scoped endpoints.
# Not required for CRM object reads.
HUBSPOT_DEV_KEY=

# Stripe restricted, read-only key (customers, subscriptions, invoices, charges).
STRIPE_KEY=

# QuickBooks Online (OPTIONAL) — enriches billing with A/R aging + balance and
# acts as a fallback when a client has no Stripe customer.
# 1. Free Intuit developer account + sandbox (sandbox has sample data).
# 2. Create an app, copy the keys below.
# 3. Register redirect URI http://localhost:3000/api/qbo/callback on the app.
# 4. Start the server and open http://localhost:3000/api/qbo/connect to authorize.
#    (The refresh token + realm id are captured automatically into .qbo-token.json.)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENV=sandbox
# Optional override; defaults to http://localhost:3000/api/qbo/callback
QUICKBOOKS_REDIRECT_URI=
# Optional: supply these instead of the connect flow (e.g. from Intuit's OAuth Playground)
QUICKBOOKS_REFRESH_TOKEN=
QUICKBOOKS_REALM_ID=

# Name of the custom HubSpot company property that stores the Stripe customer id.
# Defaults to "stripe_customer_id" if unset.
HUBSPOT_STRIPE_ID_PROPERTY=stripe_customer_id

# API server port (frontend dev server proxies /api here). Kept distinct from
# PORT so a host-injected PORT can't collide with the Vite dev server.
API_PORT=3000

# Cache TTL for joined client data, in seconds
CACHE_TTL_SECONDS=60
